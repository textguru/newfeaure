<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.or.nqis.qis.exam.dao.BranchDAO">

    <resultMap id="branchResultMap" type="kr.or.nqis.qis.exam.vo.BranchVO">
        <result column="BRANCH_CODE" property="branchCode"/>
        <result column="BRANCH_NAME" property="branchName"/>
        <result column="BRANCH_ADDR" property="branchAddr"/>
        <result column="BRANCH_TEL"  property="branchTel"/>
        <result column="USE_YN"      property="useYn"/>
    </resultMap>

    <!-- API-01: 지사 목록 조회 -->
    <select id="selectBranchList" resultMap="branchResultMap">
        SELECT
            BRANCH_CODE,
            BRANCH_NAME,
            BRANCH_ADDR,
            BRANCH_TEL,
            USE_YN
        FROM BRANCH_INFO
        WHERE USE_YN = 'Y'
        ORDER BY BRANCH_NAME ASC
    </select>

</mapper>
